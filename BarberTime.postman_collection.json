{
  "info": {
    "name": "BarberTime API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Suba o servidor (mvn compile exec:java) e rode a coleção inteira em ordem (Runner)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Calcula datas futuras válidas para a agenda do João (seg-sex 9h-18h)",
          "function proximo(diaSemana, hora) {",
          "  const d = new Date();",
          "  let dias = (diaSemana - d.getDay() + 7) % 7;",
          "  if (dias === 0) dias = 7;",
          "  d.setDate(d.getDate() + dias);",
          "  const p = n => String(n).padStart(2, \"0\");",
          "  return d.getFullYear() + \"-\" + p(d.getMonth() + 1) + \"-\" + p(d.getDate()) + \"T\" + p(hora) + \":00:00\";",
          "}",
          "pm.collectionVariables.set(\"segunda10\", proximo(1, 10));",
          "pm.collectionVariables.set(\"segunda11\", proximo(1, 11));",
          "pm.collectionVariables.set(\"quarta14\", proximo(3, 14));"
        ]
      }
    }
  ],
